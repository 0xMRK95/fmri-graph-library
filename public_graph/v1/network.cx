3-4"}, {"@id": 572, "n": "Hierarchical multi-resolution mesh networks for brain decoding", "r": "doi:10.1007/s11682-017-9774-z"}, {"@id": 573, "n": "Abnormal functional connectivity density in sleep-deprived subjects", "r": "doi:10.1007/s11682-018-9829-9"}, {"@id": 574, "n": "Identifying disease-related subnetwork connectome biomarkers by sparse hypergraph learning", "r": "doi:10.1007/s11682-018-9899-8"}, {"@id": 575, "n": "Effects of levodopa therapy on voxel-based degree centrality in Parkinson’s disease", "r": "doi:10.1007/s11682-018-9936-7"}, {"@id": 576, "n": "Overall survival time prediction for high-grade glioma patients based on large-scale brain functional networks", "r": "doi:10.1007/s11682-018-9949-2"}, {"@id": 577, "n": "Effect of emotional enhancement of memory on recollection process in young adults: the influence factors and neural mechanisms", "r": "doi:10.1007/s11682-018-9975-0"}, {"@id": 578, "n": "Graph-based network analysis of resting-state fMRI: test-retest reliability of binarized and weighted networks", "r": "doi:10.1007/s11682-019-00042-6"}, {"@id": 579, "n": "Abnormal intrinsic functional hubs and connectivity in stable patients with COPD: a resting-state MRI study", "r": "doi:10.1007/s11682-019-00130-7"}, {"@id": 580, "n": "Abnormal synchronization of functional and structural networks in schizophrenia", "r": "doi:10.1007/s11682-019-00175-8"}, {"@id": 581, "n": "Altered brain network organization in romantic love as measured with resting-state fMRI and graph theory", "r": "doi:10.1007/s11682-019-00226-0"}, {"@id": 582, "n": "Abnormal topological organization in systemic lupus erythematosus: a resting-state functional magnetic resonance imaging analysis", "r": "doi:10.1007/s11682-019-00228-y"}, {"@id": 583, "n": "Diagnosis of early Alzheimer’s disease based on dynamic high order networks", "r": "doi:10.1007/s11682-019-00255-9"}, {"@id": 584, "n": "Altered resting-state functional networks in patients with hemodialysis: a graph-theoretical b